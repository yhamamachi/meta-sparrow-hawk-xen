From 8f2d87672a06fe6f25271f7fd1aedcd0247fefc3 Mon Sep 17 00:00:00 2001
From: Volodymyr Babchuk <volodymyr_babchuk@epam.com>
Date: Tue, 7 May 2019 19:00:11 +0300
Subject: [PATCH 05/22] makefile: add support for *_defconfig targets

Signed-off-by: Volodymyr Babchuk <volodymyr_babchuk@epam.com>
Signed-off-by: Oleksandr Tyshchenko <oleksandr_tyshchenko@epam.com>
---
 xen/Makefile | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/xen/Makefile b/xen/Makefile
index 1a54194a1e..5810a9c9d2 100644
--- a/xen/Makefile
+++ b/xen/Makefile
@@ -367,6 +367,9 @@ ifeq ($(need-config),y)
 # changes are detected.
 -include include/config/auto.conf.cmd
 
+%_defconfig:
+	$(MAKE) $(kconfig) $@
+
 # Allow people to just run `make` as before and not force them to configure
 # Only run defconfig if $(KCONFIG_CONFIG) is missing
 $(KCONFIG_CONFIG): tools_fixdep
-- 
2.34.1

