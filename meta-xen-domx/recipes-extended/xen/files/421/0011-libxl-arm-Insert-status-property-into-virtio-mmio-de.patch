From 2e5abf4bd340df28cdc812b34de9d336158208a1 Mon Sep 17 00:00:00 2001
From: Oleksandr Tyshchenko <oleksandr_tyshchenko@epam.com>
Date: Sun, 11 Sep 2022 20:11:38 +0300
Subject: [PATCH 11/21] libxl/arm: Insert "status" property into virtio-mmio
 device node

Signed-off-by: Oleksandr Tyshchenko <oleksandr_tyshchenko@epam.com>
---
 tools/libs/light/libxl_arm.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/tools/libs/light/libxl_arm.c b/tools/libs/light/libxl_arm.c
index 7fd3c8b00e..c1692e630c 100644
--- a/tools/libs/light/libxl_arm.c
+++ b/tools/libs/light/libxl_arm.c
@@ -1007,6 +1007,9 @@ static int make_virtio_mmio_node_common(libxl__gc *gc, void *fdt, uint64_t base,
     res = fdt_property_interrupts(gc, fdt, &intr, 1);
     if (res) return res;
 
+    res = fdt_property_string(fdt, "status", "okay");
+    if (res) return res;
+
     res = fdt_property(fdt, "dma-coherent", NULL, 0);
     if (res) return res;
 
