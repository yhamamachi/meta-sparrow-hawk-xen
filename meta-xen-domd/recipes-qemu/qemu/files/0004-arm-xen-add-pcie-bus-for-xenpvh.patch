+static void create_pcie(XenArmState *xam)
+{
+    MemoryRegion *ecam_alias, *ecam_reg;
+    MemoryRegion *mmio_alias, *mmio_reg;
+    MemoryRegion *prefetch_alias;
+    DeviceState *dev;
+    PCIHostState *pci;
+    int i;
+
+    dev = qdev_new(TYPE_GPEX_HOST);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+
+    ecam_reg = sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0);
+    ecam_alias = g_new0(MemoryRegion, 1);
+    memory_region_init_alias(ecam_alias, OBJECT(dev), "pcie-ecam",
+                             ecam_reg, 0, GUEST_VIRTIO_PCI_HOST_ECAM_SIZE);
+    memory_region_add_subregion(get_system_memory(),
+                                GUEST_VIRTIO_PCI_ECAM_BASE, ecam_alias);
+
+    mmio_reg = sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 1);
+    mmio_alias = g_new0(MemoryRegion, 1);
+    memory_region_init_alias(mmio_alias, OBJECT(dev), "pcie-mmio",
+                             mmio_reg, GUEST_VIRTIO_PCI_MEM_ADDR,
+                             GUEST_VIRTIO_PCI_MEM_SIZE);
+    memory_region_add_subregion(get_system_memory(),
+                                GUEST_VIRTIO_PCI_MEM_ADDR, mmio_alias);
+
+    prefetch_alias = g_new0(MemoryRegion, 1);
+    memory_region_init_alias(prefetch_alias, OBJECT(dev), "pcie-mmio-prefetch",
+                             mmio_reg, GUEST_VIRTIO_PCI_PREFETCH_MEM_ADDR,
+                             GUEST_VIRTIO_PCI_PREFETCH_MEM_SIZE);
+    memory_region_add_subregion(get_system_memory(),
+                                GUEST_VIRTIO_PCI_PREFETCH_MEM_ADDR,
+                                prefetch_alias);
+
+    for (i = 0; i < GPEX_NUM_IRQS; i++) {
+        qemu_irq irq = qemu_allocate_irq(xen_set_irq, NULL,
+                                         GUEST_VIRTIO_PCI_SPI_FIRST + i);
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), i, irq);
+        gpex_set_irq_num(GPEX_HOST(dev), i, GUEST_VIRTIO_PCI_SPI_FIRST + i);
+    }
+
+    pci = PCI_HOST_BRIDGE(dev);
+    DPRINTF("Created PCIe host: ecam=0x%llx mmio=0x%llx prefetch=0x%llx irq=%d\n",
+            (uint64_t)GUEST_VIRTIO_PCI_ECAM_BASE,
+            (uint64_t)GUEST_VIRTIO_PCI_MEM_ADDR,
+            (uint64_t)GUEST_VIRTIO_PCI_PREFETCH_MEM_ADDR,
+            GUEST_VIRTIO_PCI_SPI_FIRST);
+}
+
 static void xen_init_ram(MachineState *machine)
 {
     MemoryRegion *sysmem = get_system_memory();
@@ -189,6 +240,6 @@
     xen_register_ioreq(xam->state, machine->smp.cpus, &xen_memory_listener);

-    xen_create_virtio_mmio_devices(xam);
+    create_pcie(xam);

 #ifdef CONFIG_TPM
     if (xam->cfg.tpm_base_addr) {
