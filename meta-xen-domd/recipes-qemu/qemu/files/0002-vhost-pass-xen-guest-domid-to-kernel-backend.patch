Subject: [PATCH] hw/virtio: vhost pass Xen guest domid to kernel backend
Upstream-Status: Inappropriate [embedded specific]

diff --git a/hw/virtio/vhost-backend.c b/hw/virtio/vhost-backend.c
index 17f3fc6a0..541ba496c 100644
--- a/hw/virtio/vhost-backend.c
+++ b/hw/virtio/vhost-backend.c
@@ -204,6 +204,14 @@ static int vhost_kernel_get_vq_index(struct vhost_dev *dev, int idx)
     return idx - dev->vq_index;
 }
 
+static int vhost_kernel_set_xen_guest_domid(struct vhost_dev *dev,
+                                            uint32_t domid)
+{
+    uint16_t guest_domid = domid;
+
+    return vhost_kernel_call(dev, VHOST_XEN_SET_GUEST_DOMID, &guest_domid);
+}
+
 static int vhost_kernel_vsock_set_guest_cid(struct vhost_dev *dev,
                                             uint64_t guest_cid)
 {
@@ -318,6 +326,7 @@ const VhostOps kernel_ops = {
         .vhost_set_backend_cap = vhost_kernel_set_backend_cap,
         .vhost_set_owner = vhost_kernel_set_owner,
         .vhost_get_vq_index = vhost_kernel_get_vq_index,
+        .vhost_set_xen_guest_domid = vhost_kernel_set_xen_guest_domid,
         .vhost_vsock_set_guest_cid = vhost_kernel_vsock_set_guest_cid,
         .vhost_vsock_set_running = vhost_kernel_vsock_set_running,
         .vhost_set_iotlb_callback = vhost_kernel_set_iotlb_callback,
diff --git a/hw/virtio/vhost.c b/hw/virtio/vhost.c
index 0000a6618..95946464d 100644
--- a/hw/virtio/vhost.c
+++ b/hw/virtio/vhost.c
@@ -27,6 +27,7 @@
 #include "migration/blocker.h"
 #include "migration/qemu-file-types.h"
 #include "sysemu/dma.h"
+#include "hw/xen/xen.h"
 #include "trace.h"
 
 /* enabled until disconnected backend stabilizes */
@@ -1456,6 +1457,14 @@ int vhost_dev_init(struct vhost_dev *hdev, void *opaque,
         goto fail;
     }
 
+    if (xen_mode == XEN_ATTACH && hdev->vhost_ops->vhost_set_xen_guest_domid) {
+        r = hdev->vhost_ops->vhost_set_xen_guest_domid(hdev, xen_domid);
+        if (r < 0) {
+            error_setg_errno(errp, -r, "vhost_set_xen_guest_domid failed");
+            goto fail;
+        }
+    }
+
     r = hdev->vhost_ops->vhost_get_features(hdev, &features);
     if (r < 0) {
         error_setg_errno(errp, -r, "vhost_get_features failed");
diff --git a/include/hw/virtio/vhost-backend.h b/include/hw/virtio/vhost-backend.h
index a86d103f8..74596fe0c 100644
--- a/include/hw/virtio/vhost-backend.h
+++ b/include/hw/virtio/vhost-backend.h
@@ -136,6 +136,9 @@ typedef int (*vhost_get_device_id_op)(struct vhost_dev *dev, uint32_t *dev_id);
 
 typedef bool (*vhost_force_iommu_op)(struct vhost_dev *dev);
 
+typedef int (*vhost_set_xen_guest_domid_op)(struct vhost_dev *dev,
+                                            uint32_t domid);
+
 typedef int (*vhost_set_config_call_op)(struct vhost_dev *dev,
                                        int fd);
 
@@ -195,6 +198,7 @@ typedef struct VhostOps {
     vhost_vq_get_addr_op  vhost_vq_get_addr;
     vhost_get_device_id_op vhost_get_device_id;
     vhost_force_iommu_op vhost_force_iommu;
+    vhost_set_xen_guest_domid_op vhost_set_xen_guest_domid;
     vhost_set_config_call_op vhost_set_config_call;
     vhost_reset_status_op vhost_reset_status;
     vhost_supports_device_state_op vhost_supports_device_state;
diff --git a/linux-headers/linux/vhost.h b/linux-headers/linux/vhost.h
index f5c48b61a..cdf599714 100644
--- a/linux-headers/linux/vhost.h
+++ b/linux-headers/linux/vhost.h
@@ -146,6 +146,14 @@
 #define VHOST_VSOCK_SET_GUEST_CID	_IOW(VHOST_VIRTIO, 0x60, __u64)
 #define VHOST_VSOCK_SET_RUNNING		_IOW(VHOST_VIRTIO, 0x61, int)
 
+/* VHOST_XEN specific defines */
+
+/* Tell vhost which Xen domid the guest driving this device belongs to.
+ * Needed so descriptor addresses (grant references or pseudo-physical
+ * addresses) can be mapped from the correct domain. Must be set before
+ * the device starts processing virtqueues. */
+#define VHOST_XEN_SET_GUEST_DOMID	_IOW(VHOST_VIRTIO, 0x90, __u16)
+
 /* VHOST_VDPA specific defines */
 
 /* Get the device id. The device ids follow the same definition of
