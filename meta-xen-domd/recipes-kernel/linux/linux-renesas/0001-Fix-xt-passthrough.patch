From 5dcb9e321337bf3c818dc3b97c979f85cf0a2d92 Mon Sep 17 00:00:00 2001
From: ChatGPT <chatgpt@openai.com>
Date: Mon, 27 May 2025 11:00:00 +0900
Subject: [PATCH v2] xen: Fix xt-passthrough driver for Linux 6.12 compatibility

- Add missing includes for of_count_phandle_with_args and of_device_id
- Fix incorrect pointer comparison in reset rollback
- Track reset count separately

---
 drivers/xen/xt-passthrough.c | 57 ++++++++++++++++++++++++++++++------
 1 file changed, 48 insertions(+), 9 deletions(-)

diff --git a/drivers/xen/xt-passthrough.c b/drivers/xen/xt-passthrough.c
index 3c425e71fe45..7ddabf2f3127 100644
--- a/drivers/xen/xt-passthrough.c
+++ b/drivers/xen/xt-passthrough.c
@@ -7,6 +7,8 @@
 
 #include <linux/clk.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/of_device.h>
 #include <linux/reset.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
 
 struct xt_passthrough_priv {
        struct clk **clk;
+       int clk_count;
        struct reset_control **rst;
+       int rst_count;
 };
 
 static int enable_clocks(struct device *dev, struct xt_passthrough_priv *priv)
 {
        struct device_node *np = dev->of_node;
        int i, ret, cnt;
 
        cnt = of_clk_get_parent_count(dev->of_node);
        if (!cnt)
                return 0;
+
+       priv->clk_count = cnt;
 
        priv->clk = devm_kcalloc(dev, cnt, sizeof(struct clk *), GFP_KERNEL);
        if (!priv->clk)
                return -ENOMEM;
 
        for (i = 0; i < cnt; i++) {
-               priv->clk[i] = of_clk_get(np, i);
+               char clk_name[16];
+               snprintf(clk_name, sizeof(clk_name), "clk%d", i);
+               priv->clk[i] = devm_clk_get(dev, clk_name);
                if (IS_ERR(priv->clk[i])) {
                        ret = PTR_ERR(priv->clk[i]);
                        dev_err(dev, "failed to get clk index: %d ret: %d\n",
                                i, ret);
                        priv->clk[i] = NULL;
                        goto err_put_clks;
                }
        }
@@ static int enable_clocks(struct device *dev, struct xt_passthrough_priv *priv)
        return 0;
 
 err_disable_clks:
        while (--i >= 0)
                clk_disable_unprepare(priv->clk[i]);
 err_put_clks:
-       while (--cnt >= 0)
-               if (priv->clk[i])
-                       clk_put(priv->clk[i]);
+       for (i = 0; i < priv->clk_count; i++)
+               if (priv->clk[i])
+                       clk_put(priv->clk[i]);
        return ret;
 }
 
 static int enable_resets(struct device *dev, struct xt_passthrough_priv *priv)
 {
        struct device_node *np = dev->of_node;
        int i, count, ret;
 
        count = of_count_phandle_with_args(np, "resets", "#reset-cells");
        if (count <= 0)
                return 0;
+
+       priv->rst_count = count;
 
        priv->rst = devm_kcalloc(dev, count, sizeof(struct reset_control *), GFP_KERNEL);
        if (!priv->rst)
                return -ENOMEM;
 
        for (i = 0; i < count; i++) {
                priv->rst[i] = of_reset_control_get(np, NULL);
                if (IS_ERR(priv->rst[i])) {
                        dev_err(dev, "failed to get reset control %d\n", i);
                        return PTR_ERR(priv->rst[i]);
                }
 
                ret = reset_control_deassert(priv->rst[i]);
                if (ret)
                        goto err_reset;
        }
        return 0;
 
 err_reset:
        dev_err(dev, "failed to de-assert resets, ret %d\n", ret);
-       while (--priv->rst >= 0)
-               reset_control_assert(priv->rst[i]);
+       for (i = 0; i < priv->rst_count; i++)
+               if (priv->rst[i])
+                       reset_control_assert(priv->rst[i]);
        return ret;
 }
 
 static const struct of_device_id xt_passthrough_match_table[] = {
        { .compatible = "renesas,xt-passthrough", },
        { /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, xt_passthrough_match_table);

