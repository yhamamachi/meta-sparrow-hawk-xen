From 93a3be5dd6834d5ee382935ce8eda7b95e68b6ac Mon Sep 17 00:00:00 2001
From: Yuya Hamamachi <yuya.hamamachi.sx@renesas.com>
Date: Mon, 14 Apr 2025 20:39:39 +0900
Subject: [PATCH 5/9] HACK: Add support BL31 firmware before starting U-boot

Signed-off-by: Yuya Hamamachi <yuya.hamamachi.sx@renesas.com>
---
 arch/arm/dts/r8a779g0-u-boot.dtsi      | 34 +++++++++++++++++++++-----
 configs/r8a779g3_sparrowhawk_defconfig |  5 ++++
 2 files changed, 33 insertions(+), 6 deletions(-)

diff --git a/arch/arm/dts/r8a779g0-u-boot.dtsi b/arch/arm/dts/r8a779g0-u-boot.dtsi
index cc9d99b0f34..c74adfda877 100644
--- a/arch/arm/dts/r8a779g0-u-boot.dtsi
+++ b/arch/arm/dts/r8a779g0-u-boot.dtsi
@@ -92,27 +92,41 @@
 							arch = "arm64";
 							compression = "none";
 							description = "U-Boot (64-bit)";
-							type = "standalone";
+							type = "kernel";
+							os = "u-boot";
 							/*
 							 * This is in DRAM. We cannot
 							 * use TEXT_BASE here because
 							 * this system uses PIE build
 							 * and TEXT_BASE=0x0 .
 							 */
-							entry = <0x44100000>;
-							load = <0x44100000>;
+							entry = <0x50000000>;
+							load = <0x50000000>;
 
 							uboot-blob {
-								filename = "u-boot-nodtb.bin";
+								filename = "u-boot.bin";
 								type = "blob-ext";
 							};
 						};
+						atf {
+							description = "ARM Trusted Firmware";
+							type = "tfa-bl31";
+							arch = "arm64";
+							compression = "none";
+							os = "arm-trusted-firmware";
 
+							load  = <0x46400000>;
+							entry = <0x46400000>;
+							atf-blob {
+								filename = "../bl31-hack.bin";
+								type = "blob-ext";
+							};
+						};
 						@fdt-SEQ {
+							arch = "arm64";
 							compression = "none";
 							description = "NAME";
 							type = "flat_dt";
-
 							uboot-fdt-blob {
 								filename = "u-boot.dtb";
 								type = "blob-ext";
@@ -125,12 +139,20 @@
 
 						@config-SEQ {
 							description = "NAME";
+							loadables = "uboot";
 							fdt = "fdt-SEQ";
-							firmware = "uboot";
+							kernel = "uboot";
+							firmware = "atf";
+							bl33 = "uboot";
 						};
 					};
 				};
 			};
+			fill@21ffff {
+				offset = <0x21ffff>;
+				size = <0x1>;
+				fill-byte = [00];
+			};
 		};
 	};
 };
diff --git a/configs/r8a779g3_sparrowhawk_defconfig b/configs/r8a779g3_sparrowhawk_defconfig
index 1e1e52e663e..298c4300ca6 100644
--- a/configs/r8a779g3_sparrowhawk_defconfig
+++ b/configs/r8a779g3_sparrowhawk_defconfig
@@ -64,3 +64,8 @@ CONFIG_SF_DEFAULT_SPEED=40000000
 # CONFIG_SPL_PARTITION_UUIDS is not set
 # CONFIG_SPL_DM_MMC is not set
 CONFIG_BOARD_LATE_INIT=y
+CONFIG_SPL_ATF=y
+CONFIG_SPL_ATF_SUPPORT=y
+CONFIG_SPL_ATF_TEXT_BASE=0x46400000
+CONFIG_TEXT_BASE=0x50000000
+
-- 
2.34.1

