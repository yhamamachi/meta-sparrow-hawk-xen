[Unit]
Description=DomU
Requires=backend-ready@bridge.service backend-ready@weston-up.service
After=backend-ready@bridge.service backend-ready@weston-up.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/xl create /etc/xen/domu.cfg
ExecStop=/usr/sbin/xl destroy DomU
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
